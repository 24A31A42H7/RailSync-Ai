# ---- Railway Data API (RailRadar) ----
# Leave RAILWAY_API_KEY empty to run entirely on the built-in mock provider.
RAILWAY_API_KEY="your-railway-api key"
RAILWAY_API_BASE_URL="railway base url"
RAILWAY_API_PROVIDER=real        # mock | real

# ---- Database ----
# Prototype default: SQLite (zero setup). For the full stack, use Postgres:
# DATABASE_URL=postgresql+psycopg2://railway:railway@postgres:5432/railway_maintenance
DATABASE_URL="database url"

#postgres agcxgpuEYsmbUiBkZcwddtztHgxeDEQu
#DATABASE_URL=sqlite:///./railway_maintenance.db

# ---- Auth (single MANAGER role) ----
JWT_SECRET_KEY=change_this_dev_secret_before_any_real_deployment
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

FRONTEND_URL="paste frontend url here"
# ---- Optimization objective weights (all configurable, no code change needed) ----
WEIGHT_ASSET_AVAILABILITY=10
WEIGHT_CRITICAL_TASK=25
WEIGHT_BLOCK_UTILIZATION=8
WEIGHT_COORDINATION_BENEFIT=15
WEIGHT_TRAIN_DELAY_PENALTY=20
WEIGHT_CONFLICT_PENALTY=40
WEIGHT_DOWNTIME_PENALTY=5
WEIGHT_DEADLINE_VIOLATION_PENALTY=50
WEIGHT_EARLINESS_BONUS=3
